PORTAL_TRANSLATOR_SECRET=replace-with-a-long-random-secret

# Required only for the worker service.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Keep these defaults for the pilot unless measurements prove otherwise.
PORTAL_TRANSLATOR_ALLOWED_LANGUAGES=fr,en
PORTAL_TRANSLATOR_MAX_CHARS=1000
PORTAL_TRANSLATOR_TIMEOUT_MS=5000
PORTAL_TRANSLATOR_RATE_LIMIT_PER_MINUTE=60
PORTAL_TRANSLATOR_MODEL=argos-fr-en

# Optional only if LibreTranslate is configured with an API key internally.
LIBRETRANSLATE_API_KEY=
