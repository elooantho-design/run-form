FROM node:22.14.0-alpine

WORKDIR /app

COPY api/_portal-translator-auth.js ./api/_portal-translator-auth.js
COPY ops/portal-translator/server.mjs ./ops/portal-translator/server.mjs
COPY package.json ./package.json

ENV NODE_ENV=production

USER node

CMD ["node", "ops/portal-translator/server.mjs"]
